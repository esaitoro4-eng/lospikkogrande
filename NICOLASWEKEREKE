local Players = game:GetService("Players")

-- CONFIG
local BAR_WIDTH = 4
local BAR_HEIGHT = 0.4
local Y_OFFSET = 3

local COLOR_FULL = Color3.fromRGB(0, 255, 255) -- Celeste
local COLOR_LOW  = Color3.fromRGB(255, 0, 0)   -- Rojo

-- Crear barra
local function crearBarra(character)
	local humanoid = character:WaitForChild("Humanoid")
	local head = character:WaitForChild("Head")

	-- Billboard
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HealthBar"
	billboard.Adornee = head
	billboard.Size = UDim2.new(BAR_WIDTH, 0, BAR_HEIGHT, 0)
	billboard.StudsOffset = Vector3.new(0, Y_OFFSET, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = character

	-- Fondo
	local fondo = Instance.new("Frame", billboard)
	fondo.Size = UDim2.new(1, 0, 1, 0)
	fondo.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	fondo.BorderSizePixel = 0

	-- Barra
	local barra = Instance.new("Frame", fondo)
	barra.Size = UDim2.new(1, 0, 1, 0)
	barra.BackgroundColor3 = COLOR_FULL
	barra.BorderSizePixel = 0

	-- Bordes redondos
	Instance.new("UICorner", fondo).CornerRadius = UDim.new(0, 10)
	Instance.new("UICorner", barra).CornerRadius = UDim.new(0, 10)

	-- Actualizar vida
	local function update()
		local percent = humanoid.Health / humanoid.MaxHealth
		barra.Size = UDim2.new(math.clamp(percent, 0, 1), 0, 1, 0)

		if percent <= 0.4 then
			barra.BackgroundColor3 = COLOR_LOW
		else
			barra.BackgroundColor3 = COLOR_FULL
		end
	end

	humanoid.HealthChanged:Connect(update)
	update()
end

-- Aplicar a jugadores existentes
for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		crearBarra(player.Character)
	end
	player.CharacterAdded:Connect(crearBarra)
end

-- Nuevos jugadores
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(crearBarra)
end)
