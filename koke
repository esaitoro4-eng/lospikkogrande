local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local LP = Players.LocalPlayer

--------------------------------------------------
-- ESTADO
--------------------------------------------------
local AIM_ON = false
local LOCKED_TARGET = nil
local CURRENT_PHASE = 1
local IGNORE_FRIENDS = false

--------------------------------------------------
-- SUAVIZADO POR FASE
--------------------------------------------------
local SMOOTH = {
	[1] = 0.97, -- cabeza ultra fija
	[2] = 0.78, -- más suave
	[3] = 0.55, -- cuesta más
	[4] = 0.82  -- KOKE cuerpo
}

--------------------------------------------------
-- FOV
--------------------------------------------------
local FOV_RADIUS = 160
local SHOW_FOV = true
local hue = 0

local FOV = Drawing.new("Circle")
FOV.Filled = false
FOV.Thickness = 2
FOV.NumSides = 140 -- círculo perfecto
FOV.Visible = true

--------------------------------------------------
-- MENU
--------------------------------------------------
local gui = Instance.new("ScreenGui", LP.PlayerGui)
gui.ResetOnSpawn = false

local menu = Instance.new("Frame", gui)
menu.Size = UDim2.new(0,340,0,400)
menu.Position = UDim2.new(0.03,0,0.22,0)
menu.BackgroundColor3 = Color3.fromRGB(20,20,20)
Instance.new("UICorner", menu).CornerRadius = UDim.new(0,22)

local title = Instance.new("TextLabel", menu)
title.Size = UDim2.new(1,0,0,45)
