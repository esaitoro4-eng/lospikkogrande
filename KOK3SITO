local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local LP = Players.LocalPlayer

--------------------------------------------------
-- ESTADO
--------------------------------------------------
local AIM_ON = false
local LOCKED_TARGET = nil
local CURRENT_PHASE = 1
local IGNORE_FRIENDS = false

--------------------------------------------------
-- SUAVIZADO
--------------------------------------------------
local SMOOTH = {
	[1] = 0.97,
	[2] = 0.80,
	[3] = 0.60,
	[4] = 0.82,
	[5] = 0.70
}

--------------------------------------------------
-- FOV
--------------------------------------------------
local FOV_RADIUS = 160
local SHOW_FOV = true

local FOV_COLORS = {
	Color3.fromRGB(0,200,255), -- celeste
	Color3.fromRGB(180,0,255)  -- morado
}

local fovIndex = 1
local lastSwitch = tick()
local SWITCH_TIME = 0.5

local FOV = Drawing.new("Circle")
FOV.Filled = false
FOV.Thickness = 2
FOV.NumSides = 140
FOV.Visible = true
FOV.Color = FOV_COLORS[1]
FOV.Radius = FOV_RADIUS

